# Copier vers .env.local et renseigner les valeurs depuis le tableau Supabase (Settings → API).
# Vite n’expose que les variables préfixées VITE_.

VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mot de passe pour accéder à /admin/donnees (tableau Supabase)
VITE_ADMIN_DASHBOARD_PASSWORD=changez-moi

# Phase 3 — détection maladies (optionnel)
# Clé Plant.id (client) : https://plant.id
VITE_PLANT_ID_API_KEY=

# Sur Vercel : ajouter GEMINI_API_KEY (sans VITE_) pour /api/analyze-disease (Gemini Vision)
