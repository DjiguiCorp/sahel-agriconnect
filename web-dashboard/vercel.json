{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/delete-account",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/delete-account/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/delete-account",
      "dest": "/delete-account/index.html"
    },
    {
      "src": "^(?!/_vercel|/api).*",
      "dest": "/index.html"
    }
  ]
}
