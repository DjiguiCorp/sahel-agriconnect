# Copy to .env and adjust. Never commit .env.

# Required on Render / production. For local dev, omit to use default:
#   mongodb://127.0.0.1:27017/sahel-agriconnect
# (MongoDB must be installed and running, or use Atlas below.)
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sahel-agriconnect?retryWrites=true&w=majority

# Local Mongo (default when MONGO_URI is unset and not running on Render)
# MONGO_URI=mongodb://127.0.0.1:27017/sahel-agriconnect

# API port (default 3001)
# PORT=3001

# Avoid production-style exits when testing locally — do not set on laptop:
# RENDER=true
# NODE_ENV=production

# Optional — admin bootstrap (see server.js)
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=your-secure-password

# Required for JWT issuance (admin + OTP login tokens)
# JWT_SECRET=your-long-random-secret

# Optional — POST /api/marketplace/seed-pilot (header X-Seed-Key)
# MARKETPLACE_SEED_KEY=your-long-random-secret

# Public URLs (used by /api/payments redirects + Orange notif_url)
# FRONTEND_URL=https://sahelagriconnect.com
# BACKEND_URL=https://your-backend.onrender.com

# Internal service-to-service auth for sensitive internal routes.
# Generate a long random value and set it in Render.
# INTERNAL_API_TOKEN=your-long-random-secret

# ── Payments: Stripe (enterprise tier + non-African / diaspora) ──
# Use tokens from Developers → API keys on account acct_1HkHQB… (Djigui / Sahel AgriConnect Production).
# DO NOT paste dashboard row ids that start with mk_ — those are not API keys.
# Correct formats:
#   STRIPE_SECRET_KEY=sk_live_...          (Reveal on "Sahel AgriConnect Production" secret key)
#   STRIPE_PUBLISHABLE_KEY=pk_live_...    (Publishable key on the same page)
#   STRIPE_WEBHOOK_SECRET=whsec_...       (Workbench → Webhooks → Sahel AgriConnect Production → Signing secret)
# Frontend (Vite): VITE_STRIPE_PUBLISHABLE_KEY must equal STRIPE_PUBLISHABLE_KEY

# Stripe Price IDs (Dashboard → Products → Price ID) — used by create-session
# IMPORTANT: Price IDs MUST belong to the SAME Stripe account as STRIPE_SECRET_KEY
# (acct_1HkHQB…). A price from another Stripe account → "No such price".
# Checkout falls back to inline price_data if the Price ID is missing on this account.
# Current live Price IDs on acct_1HkHQBLq2Vx8ZQ6X (update Render to match):
# STRIPE_PRICE_AFRIYIELD=price_1UcDYVLq2Vx8ZQ6XnFVYlLym          # $99/year
# STRIPE_PRICE_COOPERATIVE=price_1UcDr4Lq2Vx8ZQ6X8xtA7CEU        # $199/year
# STRIPE_PRICE_TRANSFORMAT=price_1UcDr5Lq2Vx8ZQ6XWTf4Viue        # $109/month
# STRIPE_PRICE_PRODUCER_PRO=price_1UcDr6Lq2Vx8ZQ6XdMXtfJrP       # $29.99/month
# STRIPE_PRICE_NGO=price_1UcDr7Lq2Vx8ZQ6XDxKlQvAq                # $499/month
# STRIPE_PRICE_GOVERNMENT=price_1UcDr8Lq2Vx8ZQ6XQliImcOv         # $999/month
# Webhook URL must be:
#   https://sahel-agriconnect.onrender.com/api/payments/stripe/webhook

# ── Didit identity verification (AfriYield investors) ──────────
# API: POST https://verification.didit.me/v3/session/  (NOT verify.didit.me)
# Auth: x-api-key: DIDIT_API_KEY (no OAuth / client_secret)
# DIDIT_API_KEY=sk_live_...
# DIDIT_WORKFLOW_ID=  # required — KYC workflow UUID from Didit Console → Workflows
# DIDIT_APPLICATION_ID=  # optional fallback if it equals the workflow UUID
# DIDIT_WEBHOOK_SECRET=
# DIDIT_REDIRECT_URL=https://sahelagriconnect.com/verify/callback
# DIDIT_VENDOR_DATA=sahelagriconnect

# Optional: override AfriYield investment checkout return URLs
# (must be https://sahelagriconnect.com or https://afriyieldexchange.com)
# STRIPE_INVESTMENT_SUCCESS_URL=https://sahelagriconnect.com/invest/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_INVESTMENT_CANCEL_URL=https://sahelagriconnect.com/afri-yield/opportunities

# ── Payments: Orange Money Web Pay (Mali / BF / SN / CI) ────────
# ORANGE_CLIENT_ID=...
# ORANGE_CLIENT_SECRET=...
# ORANGE_MERCHANT_KEY=...
# ORANGE_BASE_URL=https://api.orange.com

# ── Payments: MTN Mobile Money (Niger / BF / Cameroon) ─────────
# MTN_API_USER=...
# MTN_API_KEY=...
# MTN_SUBSCRIPTION_KEY=...
# MTN_BASE_URL=https://proxy.momoapi.mtn.com
# MTN_ENVIRONMENT=production

# ── Email OTP (Resend) — required for mobile/web verification emails ──
# RESEND_API_KEY=re_...
# FROM_EMAIL=onboarding@your-verified-domain.com
# WEB_APP_URL=https://sahelagriconnect.com
