# Copy to .env and adjust. Never commit .env.

# Required on Render / production. For local dev, omit to use default:
#   mongodb://127.0.0.1:27017/sahel-agriconnect
# (MongoDB must be installed and running, or use Atlas below.)
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sahel-agriconnect?retryWrites=true&w=majority

# Local Mongo (default when MONGO_URI is unset and not running on Render)
# MONGO_URI=mongodb://127.0.0.1:27017/sahel-agriconnect

# API port (default 3001)
# PORT=3001

# Avoid production-style exits when testing locally — do not set on laptop:
# RENDER=true
# NODE_ENV=production

# Optional — admin bootstrap (see server.js)
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=your-secure-password

# Optional — POST /api/marketplace/seed-pilot (header X-Seed-Key)
# MARKETPLACE_SEED_KEY=your-long-random-secret
