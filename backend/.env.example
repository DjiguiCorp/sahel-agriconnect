# Copy to .env and adjust. Never commit .env.

# Required on Render / production. For local dev, omit to use default:
#   mongodb://127.0.0.1:27017/sahel-agriconnect
# (MongoDB must be installed and running, or use Atlas below.)
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sahel-agriconnect?retryWrites=true&w=majority

# Local Mongo (default when MONGO_URI is unset and not running on Render)
# MONGO_URI=mongodb://127.0.0.1:27017/sahel-agriconnect

# API port (default 3001)
# PORT=3001

# Avoid production-style exits when testing locally — do not set on laptop:
# RENDER=true
# NODE_ENV=production

# Optional — admin bootstrap (see server.js)
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=your-secure-password

# Required for JWT issuance (admin + OTP login tokens)
# JWT_SECRET=your-long-random-secret

# Optional — POST /api/marketplace/seed-pilot (header X-Seed-Key)
# MARKETPLACE_SEED_KEY=your-long-random-secret

# Public URLs (used by /api/payments redirects + Orange notif_url)
# FRONTEND_URL=https://sahelagriconnect.com
# BACKEND_URL=https://your-backend.onrender.com

# Internal service-to-service auth for sensitive internal routes.
# Generate a long random value and set it in Render.
# INTERNAL_API_TOKEN=your-long-random-secret

# ── Payments: Stripe (enterprise tier + non-African / diaspora) ──
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: override AfriYield investment checkout return URLs
# (must be https://sahelagriconnect.com or https://afriyieldexchange.com)
# STRIPE_INVESTMENT_SUCCESS_URL=https://sahelagriconnect.com/invest/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_INVESTMENT_CANCEL_URL=https://sahelagriconnect.com/afri-yield/opportunities

# ── Payments: Orange Money Web Pay (Mali / BF / SN / CI) ────────
# ORANGE_CLIENT_ID=...
# ORANGE_CLIENT_SECRET=...
# ORANGE_MERCHANT_KEY=...
# ORANGE_BASE_URL=https://api.orange.com

# ── Payments: MTN Mobile Money (Niger / BF / Cameroon) ─────────
# MTN_API_USER=...
# MTN_API_KEY=...
# MTN_SUBSCRIPTION_KEY=...
# MTN_BASE_URL=https://proxy.momoapi.mtn.com
# MTN_ENVIRONMENT=production

# ── Email OTP (Resend) — required for mobile/web verification emails ──
# RESEND_API_KEY=re_...
# FROM_EMAIL=onboarding@your-verified-domain.com
# WEB_APP_URL=https://sahelagriconnect.com
