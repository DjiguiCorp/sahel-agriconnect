{
  "name": "sahel-agriconnect-backend",
  "version": "1.0.0",
  "description": "Backend API pour Sahel AgriConnect - Plateforme de digitalisation agricole",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "predev": "kill-port 3001 || node -e \"process.exit(0)\"",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test node --test --experimental-vm-modules tests/smoke.test.js",
    "test:watch": "cross-env NODE_ENV=test node --test --watch tests/smoke.test.js",
    "seed:marketplace": "node scripts/seedMarketplace.js"
  },
  "keywords": [
    "agriculture",
    "mali",
    "burkina-faso",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "africastalking": "^0.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "pdfkit": "^0.15.2",
    "resend": "^3.5.0",
    "socket.io": "^4.6.1",
    "stripe": "^22.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "mongodb-memory-server": "^8.12.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
